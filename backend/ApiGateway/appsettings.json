{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "sinhvien-route": {
        "ClusterId": "sinhvien-cluster",
        "Match": {
          "Path": "/api/sinhvien/{**catch-all}"
        }
      },
      "giangvien-route": {
        "ClusterId": "giangvien-cluster",
        "Match": {
          "Path": "/api/giangvien/{**catch-all}"
        }
      },
      "detai-route": {
        "ClusterId": "detai-cluster",
        "Match": {
          "Path": "/api/detai/{**catch-all}"
        }
      },
      "dangky-route": {
        "ClusterId": "dangky-cluster",
        "Match": {
          "Path": "/api/dangky/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7001"
          }
        }
      },
      "sinhvien-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7005"
          }
        }
      },
      "giangvien-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7004"
          }
        }
      },
      "detai-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7003"
          }
        }
      },
      "dangky-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7002"
          }
        }
      }
    }
  }
}